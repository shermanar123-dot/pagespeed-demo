# Copy this file to ".env" (same folder) and paste your real key below.
#
# How to get a free key:
# 1. Google Cloud Console -> APIs & Services -> Library -> search "PageSpeed Insights API" -> Enable
# 2. APIs & Services -> Credentials -> + Create Credentials -> API key
# 3. Paste the key below (no quotes needed)

PAGESPEED_API_KEY=your-api-key-here

# Optional: change the local port if 3000 is already in use on your machine
PORT=3000
